# app.py
from flask import Flask, render_template, request, redirect, url_for, flash
from flask_sqlalchemy import SQLAlchemy
from flask_login import LoginManager, UserMixin, login_required, current_user

app = Flask(__name__)
app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///projects.db'
app.config['SECRET_KEY'] = 'secret'
db = SQLAlchemy(app)
login_manager = LoginManager(app)

# ------------------ MODELS ------------------
class User(db.Model, UserMixin):
    id = db.Column(db.Integer, primary_key=True)
    email = db.Column(db.String(120), unique=True, nullable=False)
    role = db.Column(db.String(20), default="student")  # student, staff, admin

class Project(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    title = db.Column(db.String(200), nullable=False)
    description = db.Column(db.Text, nullable=False)
    category = db.Column(db.String(50))
    campus = db.Column(db.String(50))
    status = db.Column(db.String(20), default="Pending")  # Pending, In Progress, Completed, Rejected
    owner_id = db.Column(db.Integer, db.ForeignKey('user.id'))

# ------------------ ROUTES ------------------
@app.route("/submit", methods=["GET", "POST"])
@login_required
def submit_project():
    if request.method == "POST":
        new_project = Project(
            title=request.form['title'],
            description=request.form['description'],
            category=request.form['category'],
            campus=request.form['campus'],
            owner_id=current_user.id
        )
        db.session.add(new_project)
        db.session.commit()
        flash("Project submitted for admin approval!", "success")
        return redirect(url_for("dashboard"))
    return render_template("submit.html")

@app.route("/admin")
@login_required
def admin_dashboard():
    if current_user.role != "admin":
        flash("Access denied!", "danger")
        return redirect(url_for("dashboard"))
    pending_projects = Project.query.filter_by(status="Pending").all()
    return render_template("admin_dashboard.html", projects=pending_projects)

@app.route("/approve/<int:project_id>")
@login_required
def approve_project(project_id):
    if current_user.role == "admin":
        project = Project.query.get_or_404(project_id)
        project.status = "In Progress"
        db.session.commit()
        flash("Project approved!", "success")
    return redirect(url_for("admin_dashboard"))

@app.route("/reject/<int:project_id>")
@login_required
def reject_project(project_id):
    if current_user.role == "admin":
        project = Project.query.get_or_404(project_id)
        project.status = "Rejected"
        db.session.commit()
        flash("Project rejected!", "warning")
    return redirect(url_for("admin_dashboard"))

@app.route("/dashboard")
@login_required
def dashboard():
    projects = Project.query.filter(Project.status != "Rejected").all()
    return render_template("dashboard.html", projects=projects)

# ------------------ MAIN ------------------
if __name__ == "__main__":
    db.create_all()
    app.run(debug=True)
